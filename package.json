{
  "name": "mesh-cprt",
  "version": "1.0.0",
  "description": "Custom code for the CPRT Webflow site — Sygnal Site Engine",
  "main": "dist/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "serve": "serve",
    "build": "node build.js",
    "build:prod": "node build.js && npm run minify",
    "watch": "node build.js --watch",
    "minify": "esbuild dist/index.js --minify --sourcemap --outfile=dist/index.js --allow-overwrite",
    "typecheck": "tsc --noEmit",
    "format": "prettier src/**/*.{ts,scss} -w",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/addisongabriel/mesh-cprt.git"
  },
  "author": {
    "name": "Sitesmith",
    "url": "https://sitesmith.build"
  },
  "license": "",
  "devDependencies": {
    "esbuild": "^0.15.14",
    "prettier": "^2.7.1",
    "sass": "^1.93.2",
    "serve": "^14.1.1",
    "typescript": "^4.9.3"
  },
  "dependencies": {
    "@sygnal/sse-core": "^2.2.0",
    "glob": "^10.4.2",
    "js-cookie": "^3.0.5"
  }
}
